# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskmanager?schema=public"

# Secret used to sign/verify JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# JWT lifetime, e.g. "1h", "7d"
JWT_EXPIRES_IN="7d"

# Port the Express/Apollo server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS (frontend URL(s))
CORS_ORIGIN="http://localhost:5173"

# "development" | "production"
NODE_ENV="development"
